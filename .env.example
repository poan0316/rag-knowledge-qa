# ===== LLM 提供方：ollama（本地免费，默认） | openai（云端付费）=====
LLM_PROVIDER=ollama

# ===== Ollama 配置（本地）=====
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# ===== OpenAI 配置（可选，需 API Key）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ===== 向量库 =====
CHROMA_DIR=data/chroma
COLLECTION_NAME=ai_interview_kb

# ===== RAG 参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
